{
  "description": "仅同步任务状态到本机桌宠，不保存提示词或回复。",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/pet_bridge.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/pet_bridge.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/pet_bridge.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
